        ],
        "summary": "X402List Txt",
        "description": "One-time ownership token for x402-list update verification.",
        "operationId": "x402list_txt__well_known_x402list_txt_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": []
      }
    },
