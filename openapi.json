  "components": {
    "schemas": {
      "BinPackingInput": {
        "properties": {
          "item_weights": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "minItems": 1,
            "title": "Item Weights",
            "description": "item weights"
          },
          "bin_capacity": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Bin Capacity"
          },
          "max_bins": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Bins"
          }
        },
        "type": "object",
        "required": [
          "item_weights",
          "bin_capacity"
        ],
        "title": "BinPackingInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OptimizeRequest": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemInput"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "auto | classical | hybrid | quantum. auto returns the best evidence-backed recommendation for your problem.",
            "default": "auto"
          },
          "webhook_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Url",
            "description": "Optional: POST the final job payload (with signed receipt) to this URL on completion."
          }
        },
        "type": "object",
        "required": [
          "problem"
        ],
        "title": "OptimizeRequest",
        "example": {
          "mode": "auto",
          "problem": {
            "data": {
              "linear": [
                1.0,
                -2.0,
                3.0,
                -4.0
              ],
              "quadratic": {
                "0,1": -1.5,
                "1,2": 0.5,
                "2,3": -2.0
              }
            },
            "n": 4,
            "problem_type": "qubo"
          }
        }
      },
      "PortfolioInput": {
        "properties": {
          "returns": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Returns",
            "description": "expected per-asset return (any units)"
          },
          "covariance": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Covariance",
            "description": "n x n covariance matrix"
          },
          "cardinality": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cardinality",
            "description": "max assets to select"
          },
          "risk_aversion": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Risk Aversion",
            "default": 1.0
          },
          "cardinality_penalty": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Cardinality Penalty",
            "default": 2.0
          }
        },
        "type": "object",
        "required": [
          "returns",
          "covariance"
        ],
        "title": "PortfolioInput"
      },
      "ProblemInput": {
        "properties": {
          "problem_type": {
            "type": "string",
            "title": "Problem Type",
            "description": "qubo | ising",
            "default": "qubo"
          },
          "n": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 2.0,
            "title": "N",
            "description": "number of variables"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "{\"linear\": [...], \"quadratic\": {\"i,j\": coeff}}"
          }
        },
        "type": "object",
        "required": [
          "n",
          "data"
        ],
        "title": "ProblemInput"
      },
      "RoutingInput": {
        "properties": {
          "distances": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Distances",
            "description": "N x N pairwise distance matrix"
          }
        },
        "type": "object",
        "required": [
          "distances"
        ],
        "title": "RoutingInput"
      },
      "TrialRequest": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemInput"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "auto | classical | hybrid | quantum",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "problem"
        ],
        "title": "TrialRequest",
        "example": {
          "mode": "auto",
          "problem": {
            "data": {
              "linear": [
                -0.5,
                -1.2,
                -0.8,
                -2.0,
                -0.3,
                -1.5
              ],
              "quadratic": {
                "0,1": 0.3,
                "1,3": 0.4
              }
            },
            "n": 6,
            "problem_type": "qubo"
          }
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}