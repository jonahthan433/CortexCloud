  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OptimizeRequest": {
        "properties": {
          "problem": {
            "$ref": "#/components/schemas/ProblemInput"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "auto | classical | hybrid | quantum. auto picks the cheapest honest path; quantum requires an available configured backend (Origin or AWS Braket).",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "problem"
        ],
        "title": "OptimizeRequest",
        "example": {
          "mode": "auto",
          "problem": {
            "data": {
              "linear": [
                1.0,
                -2.0,
                3.0,
                -4.0
              ],
              "quadratic": {
                "0,1": -1.5,
                "1,2": 0.5,
                "2,3": -2.0
              }
            },
            "n": 4,
            "problem_type": "qubo"
          }
        }
      },
      "ProblemInput": {
        "properties": {
          "problem_type": {
            "type": "string",
            "title": "Problem Type",
            "description": "qubo | ising",
            "default": "qubo"
          },
          "n": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 2.0,
            "title": "N",
            "description": "number of variables"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "{\"linear\": [...], \"quadratic\": {\"i,j\": coeff}}"
          }
        },
        "type": "object",
        "required": [
          "n",
          "data"
        ],
        "title": "ProblemInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "x402": {
        "type": "http",
        "scheme": "bearer",
        "description": "x402 payment: obtain a 402 PaymentRequirements challenge, answer with a wallet authorization, pass it back in the X-PAYMENT signature header."
      }
    }
  }
