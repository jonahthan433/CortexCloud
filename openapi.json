{
  "openapi": "3.1.0",
  "info": {
    "title": "CortexCloud On-Chain Data API",
    "description": "Pay-per-call on-chain data and intelligence for AI agents: token, wallet, risk, whale, balance, NFT, transaction and cross-chain reads. Evidence-backed JSON, settled in USDC on Base via x402. No API keys, no signup.",
    "version": "2.0.0",
    "x-guidance": "CortexCloud \u2014 pay-per-call on-chain data for AI agents. Every paid route is POST/GET under /v1/data or /v1/aggregate and returns HTTP 402 with an x402 PaymentRequirements challenge (USDC on Base, eip155:8453) when no payment is attached. Sign the challenge (EIP-3009, gasless) and resend with the payment-signature header; the data comes back in the same response. GET /v1/capabilities lists every route and price for free. Discovery: /.well-known/x402.json, /.well-known/bazaar, /llms.txt, /openapi.json, and the MCP server at /mcp. No API keys, no subscriptions.",
    "x-apisguru-categories": [
      "blockchain"
    ],
    "contact": {
      "email": "team@cortexcloud.org"
    }
  },
  "paths": {
