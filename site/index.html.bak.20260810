<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CortexCloud — Pay-per-call optimization API for AI agents</title>
<meta name="description" content="Optimization infrastructure for autonomous agents: classical, hybrid and real quantum solvers behind one API. Agents discover via MCP/x402, estimate free, and pay per call in USDC on Base. No API keys, no signup.">
<meta name="robots" content="index, follow">
<link rel="canonical" href="https://api.cortexcloud.org/">
<meta property="og:type" content="website">
<meta property="og:title" content="CortexCloud — Optimization infrastructure for autonomous agents">
<meta property="og:description" content="Classical, hybrid and real quantum solvers behind one pay-per-call API. x402 + USDC on Base. Estimate free, solve from $0.05.">
<meta property="og:image" content="https://api.cortexcloud.org/og.svg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="CortexCloud — Optimization infrastructure for autonomous agents">
<meta name="twitter:description" content="Pay-per-call optimization API for AI agents. Classical, hybrid, real quantum. x402 + USDC on Base.">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CortexCloud",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any (REST API)",
  "description": "Pay-per-call QUBO/Ising optimization API for AI agents: classical, hybrid and real quantum (Rigetti Cepheus via Amazon Braket) backends, x402/USDC payments on Base, MCP server.",
  "url": "https://api.cortexcloud.org/",
  "sameAs": ["https://github.com/jonahthan433/CortexCloudAPI"],
  "offers": {
    "@type": "Offer",
    "price": "0.05",
    "priceCurrency": "USD",
    "description": "Pay per optimization call. Classical from $0.05, hybrid $0.10, quantum from $1.503. Estimate endpoint is free."
  }
}
</script>
<style>
  :root {
    --bg: #0a0e1a; --bg2: #0d1428; --panel: #111a30; --border: #22304f;
    --text: #e8eaf2; --muted: #aab4cc; --dim: #7c88a6;
    --blue: #4d8dff; --blue-d: #2563eb; --green: #3ddc84; --amber: #ffd166;
    --red: #ff6b6b; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; -webkit-font-smoothing: antialiased; }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; }
  code { font-family: var(--mono); font-size: 0.9em; background: #16203a; border: 1px solid var(--border); border-radius: 5px; padding: 0.12em 0.4em; }
  pre { font-family: var(--mono); font-size: 0.85rem; line-height: 1.55; background: #080c16; border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.1rem; overflow-x: auto; margin: 0.8rem 0; position: relative; }
  pre code { background: none; border: none; padding: 0; font-size: inherit; }
  .skip-link { position: absolute; left: -999px; top: 0; background: var(--blue); color: #fff; padding: 0.5rem 1rem; border-radius: 0 0 8px 0; z-index: 50; }
  .skip-link:focus { left: 0; }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; border-radius: 4px; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }
  /* Nav */
  nav { position: sticky; top: 0; z-index: 40; background: rgba(10,14,26,0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
  .nav-in { display: flex; align-items: center; gap: 1.2rem; padding: 0.75rem 1.5rem; max-width: 1080px; margin: 0 auto; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 0.55rem; font-weight: 800; font-size: 1.05rem; letter-spacing: -0.01em; color: var(--text); }
  .brand img { width: 26px; height: 26px; }
  .nav-links { display: flex; align-items: center; gap: 1.1rem; margin-left: auto; flex-wrap: wrap; font-size: 0.92rem; }
  .nav-links a { color: var(--muted); }
  .nav-links a:hover { color: var(--text); text-decoration: none; }
  .status-pill { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; font-weight: 600; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 0.22rem 0.7rem; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dim); }
  .status-dot.ok { background: var(--green); box-shadow: 0 0 6px rgba(61,220,132,0.6); }
  .status-dot.warn { background: var(--amber); }
  .status-dot.bad { background: var(--red); }
  /* Hero */
  header.hero { padding: 4.5rem 0 3rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.12; max-width: 18ch; }
  .hero h1 .grad { background: linear-gradient(90deg, #6ea8fe, #3ddc84); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero .sub { color: var(--muted); font-size: 1.13rem; max-width: 60ch; margin: 1.1rem 0 1.6rem; }
  .hero-cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.68rem 1.25rem; border-radius: 9px; font-weight: 700; font-size: 0.95rem; border: 1px solid var(--border); color: var(--text); background: var(--panel); }
  .btn:hover { text-decoration: none; border-color: var(--blue); }
  .btn.primary { background: var(--blue-d); border-color: var(--blue-d); color: #fff; }
  .btn.primary:hover { background: #1d4ed8; }
  .btn.ghost { background: transparent; }
  .hero-meta { margin-top: 1.4rem; display: flex; gap: 1.4rem; flex-wrap: wrap; color: var(--dim); font-size: 0.85rem; }
  .hero-meta b { color: var(--muted); font-weight: 600; }
  /* Code hero */
  .code-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: #080c16; margin: 2rem 0; }
  .code-tabs { display: flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1rem; border-bottom: 1px solid var(--border); background: var(--panel); font-size: 0.8rem; color: var(--dim); }
  .code-tabs .dot { width: 10px; height: 10px; border-radius: 50%; background: #2a3a63; }
  .code-tabs .dot:first-child { background: #ff6b6b; opacity: 0.7; }
  .code-tabs .dot:nth-child(2) { background: #ffd166; opacity: 0.7; }
  .code-tabs .dot:nth-child(3) { background: #3ddc84; opacity: 0.7; }
  .code-tabs .t { margin-left: 0.6rem; font-family: var(--mono); }
  .copy-btn { margin-left: auto; background: none; border: 1px solid var(--border); color: var(--muted); font-size: 0.75rem; border-radius: 6px; padding: 0.2rem 0.6rem; cursor: pointer; font-family: inherit; }
  .copy-btn:hover { color: var(--text); border-color: var(--blue); }
  pre .resp { color: #9ad1a5; }
  .pre-label { display: block; color: var(--dim); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0.9rem 1.1rem 0; }
  /* Sections */
  section { padding: 2.8rem 0; border-top: 1px solid #141d33; }
  h2 { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; }
  .sec-sub { color: var(--muted); max-width: 62ch; margin: 0.6rem 0 1.6rem; }
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.1rem; counter-reset: step; }
  .step { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 1.2rem 1.2rem 1.4rem; }
  .step::before { counter-increment: step; content: counter(step); display: block; width: 30px; height: 30px; border-radius: 8px; background: var(--blue-d); color: #fff; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-bottom: 0.7rem; }
  .step h3 { font-size: 1.02rem; margin-bottom: 0.35rem; }
  .step p { color: var(--muted); font-size: 0.92rem; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.1rem; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 1.3rem; }
  .card h3 { font-size: 1.02rem; margin-bottom: 0.3rem; display: flex; align-items: center; gap: 0.5rem; }
  .card .price { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; }
  .card .price small { font-size: 0.8rem; color: var(--dim); font-weight: 500; }
  .card p { color: var(--muted); font-size: 0.9rem; margin: 0.4rem 0 0.8rem; }
  .tag { display: inline-block; border-radius: 999px; padding: 0.14rem 0.65rem; font-size: 0.72rem; font-weight: 700; }
  .tag.free { background: #123524; color: var(--green); }
  .tag.paid { background: #3a2a10; color: var(--amber); }
  .tag.live { background: #123524; color: var(--green); }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.93rem; }
  th, td { text-align: left; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--border); }
  th { color: var(--dim); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
  td b { color: var(--text); }
  .note { color: var(--dim); font-size: 0.85rem; margin-top: 0.5rem; }
  .foot { padding: 2.5rem 0 3.5rem; color: var(--dim); font-size: 0.85rem; border-top: 1px solid #141d33; }
  .foot a { color: var(--muted); }
  @media (max-width: 640px) {
    header.hero { padding-top: 3rem; }
    .nav-links { gap: 0.8rem; }
    pre { font-size: 0.78rem; padding: 0.8rem; }
  }
</style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<nav aria-label="Primary">
  <div class="nav-in">
    <a class="brand" href="/"><img src="/logo-mark.png" alt="" width="26" height="26">CortexCloud</a>
    <div class="nav-links">
      <a href="#how">How it works</a>
      <a href="#capabilities">Capabilities</a>
      <a href="#pricing">Pricing</a>
      <a href="#docs">Docs</a>
      <a href="https://github.com/jonahthan433/CortexCloudAPI" rel="noopener">GitHub</a>
      <span class="status-pill" id="status" role="status" aria-live="polite"><span class="status-dot" aria-hidden="true"></span><span id="status-text">Checking…</span></span>
      <a class="btn primary" href="/v1/examples" style="padding:0.45rem 1rem;">Try the API</a>
    </div>
  </div>
</nav>

<main id="main">
<header class="hero wrap">
  <h1>Optimization infrastructure for <span class="grad">autonomous agents</span></h1>
  <p class="sub">Classical, hybrid, and real quantum solvers behind one API. Agents discover it via MCP and x402, estimate for free, and pay per call in USDC on Base — no API keys, no signup, no subscriptions.</p>
  <div class="hero-cta">
    <a class="btn primary" href="/v1/examples">Run a live example</a>
    <a class="btn ghost" href="/openapi.json">Read the API docs</a>
  </div>
  <div class="hero-meta">
    <span>Estimate: <b>free</b></span>
    <span>Solve from <b>$0.05</b></span>
    <span>Quantum from <b>$1.503</b></span>
    <span>Payments: <b>x402 · USDC · Base</b></span>
  </div>

  <div class="code-card" id="code-hero">
    <div class="code-tabs"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="t">POST /v1/estimate — free</span><button class="copy-btn" data-copy="curl-hero" aria-label="Copy example">Copy</button></div>
    <pre id="curl-hero"><code><span style="color:#7c88a6"># An agent asks: which solver, how much, how fast?</span>
curl -s https://api.cortexcloud.org/v1/estimate \
  -H 'content-type: application/json' \
  -d '{"problem_type":"qubo","n":6,"data":{"linear":[1,-2,3,-4,2,-1],"quadratic":{"0,1":-1.5,"1,2":2.0,"2,3":-0.5,"3,4":1.0,"4,5":-2.0}}}'</code></pre>
    <span class="pre-label">Response — real recommendation with exact price</span>
    <pre><code class="resp">{
  "recommendation": {
    "backend": "brute-force",
    "mode": "classical",
    "estimated_runtime_s": 0.001,
    "estimated_price_usd": 0.0,
    "cortexcloud_price_usd": 0.05,
    "reason": "exact enumeration fits this size at lowest cost"
  }
}</code></pre>
    <span class="pre-label">Then, to solve: the x402 challenge</span>
    <pre><code><span style="color:#7c88a6"># POST /v1/optimize replies 402 with a price in USDC (Base).
# The agent signs the payment; the job runs; GET /v1/jobs/{id} returns it.</span>
HTTP 402 Payment Required
{"scheme":"x402","network":"eip155:8453","asset":"USDC",
 "amount":"0.050000","payTo":"0x5a03…ea143"}</code></pre>
  </div>
</header>

<section id="how" class="wrap">
  <h2>How an agent uses it</h2>
  <p class="sec-sub">Three requests, zero accounts. The entire loop is machine-native: discovery, a free estimate, then a pay-per-call solve.</p>
  <div class="steps">
    <div class="step"><h3>Discover</h3><p><code>/.well-known/x402.json</code>, <code>/.well-known/bazaar</code>, <code>/llms.txt</code>, <code>/openapi.json</code>, and an MCP server at <code>/mcp</code> (4 tools). Agents find CortexCloud the same way humans find a website.</p></div>
    <div class="step"><h3>Estimate — free</h3><p><code>POST /v1/estimate</code> returns the recommended mode, algorithm, backend, runtime, and exact price for a QUBO/Ising problem. No payment, no signup.</p></div>
    <div class="step"><h3>Pay &amp; solve</h3><p><code>POST /v1/optimize</code> issues an x402 challenge (USDC on Base). The agent settles, the job executes, <code>GET /v1/jobs/{id}</code> returns the solution.</p></div>
  </div>
</section>

<section id="capabilities" class="wrap">
  <h2>Capabilities</h2>
  <p class="sec-sub">Binary decision problems as QUBO/Ising: scheduling, routing, portfolio selection, staffing, facility placement, knapsack, max-cut. Sized classical solvers for everything; real QPU hardware for the hard stuff.</p>
  <div class="grid3">
    <div class="card">
      <h3>Classical</h3>
      <div class="price">$0.05–0.25 <small>by problem size</small></div>
      <p><code>brute-force</code> exact for n ≤ 20, <code>simulated-annealing</code> beyond. Sized pricing: n ≤ 20 → $0.05 · 21–200 → $0.10 · &gt;200 → $0.25.</p>
      <span class="tag live">LIVE</span>
    </div>
    <div class="card">
      <h3>Hybrid</h3>
      <div class="price">$0.10</div>
      <p><code>qaoa-local</code> — QAOA ansatz with a classical outer loop. The middle ground between exact and QPU.</p>
      <span class="tag live">LIVE</span>
    </div>
    <div class="card">
      <h3>Quantum</h3>
      <div class="price">$1.503</div>
      <p><code>rigetti</code> — Rigetti Cepheus-1-108Q (156-qubit-class gate model) via Amazon Braket, 1024 shots. IBM Quantum open-plan as fallback.</p>
      <span class="tag live">LIVE</span>
    </div>
  </div>
  <p class="note">Quantum is recommended only with benchmark evidence — never on marketing. Prices are the real charged amounts: provider cost + infra + payment, marked up 2x, and the API refuses any request that would lose money.</p>
</section>

<section id="payments" class="wrap">
  <h2>Agent-native payments</h2>
  <p class="sec-sub">No API keys. No billing portal. No human in the loop. The protocol negotiates the price, and the agent pays in USDC on Base via x402 — the same rail 90% of x402 transactions settle on.</p>
  <table>
    <tr><th>Property</th><th>CortexCloud</th></tr>
    <tr><td>Authentication</td><td>None required — payments are the auth</td></tr>
    <tr><td>Scheme</td><td><b>x402</b> (HTTP 402 + signed settlement, USDC on Base, chain eip155:8453)</td></tr>
    <tr><td>Discovery</td><td><code>/.well-known/x402</code>, <code>x402.json</code>, MCP registry <code>io.github.jonahthan433/cortexcloud</code></td></tr>
    <tr><td>Billing</td><td>Per successful call, exact amount quoted before execution</td></tr>
    <tr><td>Safety</td><td>Invalid requests rejected <b>before</b> settlement; no charge for unrunnable jobs</td></tr>
  </table>
</section>

<section id="pricing" class="wrap">
  <h2>Transparent pricing</h2>
  <p class="sec-sub">The estimate endpoint quotes the exact charge before you pay. Unit economics published in the open — because infrastructure pricing should survive contact with the real world.</p>
  <table>
    <tr><th>Mode</th><th>Solver / backend</th><th>Price</th></tr>
    <tr><td><b>classical</b></td><td><code>brute-force</code> (exact, n≤20) · <code>simulated-annealing</code> (n&gt;20)</td><td><b>$0.05 / $0.10 / $0.25</b> by size</td></tr>
    <tr><td><b>hybrid</b></td><td><code>qaoa-local</code> (QAOA + classical outer loop)</td><td><b>$0.10</b></td></tr>
    <tr><td><b>quantum</b></td><td><code>rigetti</code> — Cepheus-1-108Q via AWS Braket (1024 shots)</td><td><b>$1.503</b></td></tr>
    <tr><td>estimate</td><td><code>POST /v1/estimate</code> — analyze + recommend</td><td><b>free</b></td></tr>
  </table>
  <p class="note">Cost basis (published): Braket rate card $0.30/task + $0.000425/shot → $0.7352 at 1024 shots; infra $0.001 + payment $0.0005 per request. Charged = max(list, 2× total cost). Loss-making requests are refused, not subsidized.</p>
</section>

<section id="docs" class="wrap">
  <h2>Start in 60 seconds</h2>
  <p class="sec-sub">From landing to first paid call without creating an account.</p>
  <div class="grid3">
    <div class="card"><h3>Examples</h3><p>Copy-paste curl demos for scheduling, portfolio allocation, and routing — every one a free estimate.</p><a class="btn" href="/v1/examples">Open examples</a></div>
    <div class="card"><h3>MCP</h3><p>Connect Claude, Cursor, or Codex to the 4-tool MCP server with one command.</p><pre style="font-size:0.72rem;margin:0.5rem 0 0.8rem;"><code>claude mcp add cortexcloud --transport http https://api.cortexcloud.org/mcp</code></pre><a class="btn" href="/mcp">MCP info</a></div>
    <div class="card"><h3>Reference</h3><p>Full OpenAPI spec, x402 manifest, agent discovery files, and the source on GitHub.</p><a class="btn" href="/openapi.json">OpenAPI</a> <a class="btn ghost" href="https://github.com/jonahthan433/CortexCloudAPI" rel="noopener">GitHub</a></div>
  </div>
  <p class="note" style="margin-top:1.2rem;">Discovery surface: <a href="/llms.txt">llms.txt</a> · <a href="/.well-known/x402.json">x402.json</a> · <a href="/.well-known/bazaar">Bazaar</a> · <a href="/.well-known/agentsearch.txt">agentsearch.txt</a> · <a href="/openapi.json">OpenAPI</a> · <a href="/health">status</a></p>
</section>

<footer class="foot wrap">
  <p>CortexCloud — pay-per-call optimization infrastructure for autonomous agents. No API keys. No subscriptions. Real quantum. Real prices. · <a href="https://github.com/jonahthan433/CortexCloudAPI" rel="noopener">GitHub</a> · <a href="/health">Status</a></p>
</footer>
</main>

<script>
// Live status from the real health endpoint
(function () {
  var dot = document.querySelector('.status-dot'), txt = document.getElementById('status-text');
  fetch('/health', {headers: {'accept': 'application/json'}})
    .then(function (r) { return r.json(); })
    .then(function (d) {
      var ok = d.status === 'healthy' && d.backends && d.backends.quantum.available >= 1;
      dot.className = 'status-dot ' + (ok ? 'ok' : 'warn');
      txt.textContent = ok ? 'All systems operational' : 'Degraded — check /health';
    })
    .catch(function () { dot.className = 'status-dot bad'; txt.textContent = 'Status unavailable'; });
})();

// Copy buttons
document.querySelectorAll('.copy-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var el = document.getElementById(btn.dataset.copy);
    var text = el ? el.innerText : '';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy'; }, 1500); });
    } else {
      btn.textContent = 'Select manually'; setTimeout(function () { btn.textContent = 'Copy'; }, 2000);
    }
  });
});

// GTM tracking beacon — anonymous visit/referrer capture
fetch('/v1/track?ref=' + encodeURIComponent(document.referrer)
  + '&src=' + encodeURIComponent(new URLSearchParams(location.search).get('utm_source') || '')
  + '&med=' + encodeURIComponent(new URLSearchParams(location.search).get('utm_medium') || '')
  + '&cmp=' + encodeURIComponent(new URLSearchParams(location.search).get('utm_campaign') || ''), {keepalive: true});
</script>
</body>
</html>
