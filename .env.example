# CortexCloud Optimization Network — environment template.
# Copy to .env and fill. Values shown are examples only.

# --- PostgreSQL (only datastore: jobs, executions, payments, usage, benchmarks)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cortexcloud
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- App
ENV=production
PROJECT_NAME=CortexCloud Optimization Network
ALLOWED_ORIGINS=*

# --- x402 payments (USDC on Base)
X402_ENABLED=true
X402_NETWORK=base
WALLET_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_ADDRESS_2=0x0000000000000000000000000000000000000000
X402_RESOURCE_BASE=https://api.cortexcloud.org
X402_FACILITATOR_API_KEY_ID=
X402_FACILITATOR_API_KEY_SECRET=
X402_RATE_LIMIT=100

# --- Origin Quantum / Wukong (optional, isolated adapter)
# ORIGIN_API_TOKEN=
# ORIGIN_BACKEND=

# --- Logging
LOG_LEVEL=INFO