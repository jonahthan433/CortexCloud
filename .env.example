# ─────────────────────────────────────────────────────────────
# CortexCloud — single deployable module
# Copy to .env, edit, then: docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# ── Deployment mode ──────────────────────────────────────────
#   public  = x402/USDC-on-Base settlement (public gateway mode)
#             X402_ENABLED=true, PRIVATE_API_KEY empty
#   private = single-tenant instance, static API key, no blockchain
#             X402_ENABLED=false, PRIVATE_API_KEY=<openssl rand -hex 24>
X402_ENABLED=false
PRIVATE_API_KEY=CHANGE_ME_openssl_rand_hex_24

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=cortexcloud
POSTGRES_HOST=postgres        # compose service name — do not change
POSTGRES_PORT=5432
DATABASE_URL=                 # optional; else built from the values above

# ── Public x402 mode only (leave empty in private mode) ──────
WALLET_ADDRESS=
X402_RESOURCE_BASE=https://api.yourdomain.com
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_API_KEY_ID=
X402_FACILITATOR_API_KEY_SECRET=
X402_NETWORK=eip155:8453
MPP_ENABLED=false

# ── Solvers ──────────────────────────────────────────────────
# Private instances run classical/hybrid solvers locally.
# Quantum backends stay OFF unless you supply provider tokens.
MAX_OPTIMIZE_VARS=5000
QAOA_LOCAL_MAX_N=12
QUANTUM_LIVE_EXECUTION=false
ORIGINQ_API_TOKEN=
IBM_QUANTUM_TOKEN=
BRAKET_REGIONS=us-east-1,us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── MCP server (optional) ────────────────────────────────────
# CORTEXCLOUD_BASE: API the MCP server settles against.
#   public  -> https://api.cortexcloud.org (default)
#   private -> http://api:8000 (compose-internal; key-aware MCP build
#              required — see DEPLOY.md "Private mode + MCP")
CORTEXCLOUD_BASE=https://api.cortexcloud.org
CORTEXCLOUD_PAYTO=
EVM_PRIVATE_KEY=             # public mode: wallet used by the MCP server
MCP_PORT=3100

# ── Ports ────────────────────────────────────────────────────
API_PORT=8000

# ── Misc ─────────────────────────────────────────────────────
ENV=production
BACKEND_CORS_ORIGINS=*
