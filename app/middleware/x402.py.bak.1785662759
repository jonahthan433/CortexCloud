import base64
import json
import logging
from typing import Optional

import httpx
from fastapi import Request, status
from fastapi.responses import JSONResponse
from starlette.middleware.base import BaseHTTPMiddleware, RequestResponseEndpoint
from starlette.responses import Response

from app.core.config import settings
from app.x402.pricing import ROUTE_PRICING, ROUTE_DESCRIPTIONS, usd_to_usdc_atomic

logger = logging.getLogger("cortexcloud.middleware.x402")

# Per-route JSON input/output schemas for the x402 v2 Bazaar discovery
# extension. Required by x402scan's validator (SCHEMA_INPUT_MISSING is a hard
# error if the 402 body lacks an input schema).
BAZAAR_SCHEMAS = {
    "/x402/v1/chat/completions": {
        "input": {
            "type": "object",
            "properties": {
                "model": {"type": "string", "description": "Model id, e.g. gemini/gemini-2.0-flash"},
                "messages": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "role": {"type": "string", "enum": ["system", "user", "assistant", "tool"]},
                            "content": {"type": "string"}
                        },
                        "required": ["role", "content"]
                    }
                },
                "stream": {"type": "boolean"},
                "temperature": {"type": "number"},
                "max_tokens": {"type": "integer"}
            },
            "required": ["model", "messages"]
        },
        "output": {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "object": {"type": "string"},
                "choices": {"type": "array"},
                "usage": {"type": "object"}
            }
        }
    },
    "/x402/v1/embeddings": {
        "input": {
            "type": "object",
            "properties": {
                "input": {"type": "string", "description": "Text to embed"},
                "model": {"type": "string", "description": "Embedding model id, e.g. gemini/text-embedding-004"}
            },
            "required": ["input", "model"]
        },
        "output": {
            "type": "object",
            "properties": {
                "id": {"type": "string"},
                "object": {"type": "string"},
                "embeddings": {"type": "array"},
                "usage": {"type": "object"}
            }
        }
    },
    # For image generation, we don't need to specify input/output schema for now? 
    # But x402scan requires it. We'll provide a generic one.
    "/x402/v1/images/generations": {
        "input": {
            "type": "object",
            "properties": {
                "model": {"type": "string"},
                "prompt": {"type": "string"},
                "n": {"type": "integer"},
                "size": {"type": "string"},
                "response_format": {"type": "string"}
            },
            "required": ["prompt"]
        },
        "output": {
            "type": "object",
            "properties": {
                "created": {"type": "integer"},
                "data": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "url": {"type": "string"},
                            "b64_json": {"type": "string"}
                        }
                    }
                }
            }
        }
    }
}

# Cache for model pricing to avoid hitting the database on every request
from functools import lru_cache

@lru_cache(maxsize=1)
def get_model_pricing():
    """Fetch model pricing from the database and return a dict keyed by model ID."""
    try:
        from app.services.models import get_models
        models = get_models()  # Returns list of model objects
        pricing = {}
        for model in models:
            pricing[model.id] = {
                "input_cost_per_1k_tokens": float(model.input_cost_per_1k_tokens),
                "output_cost_per_1k_tokens": float(model.output_cost_per_1k_tokens),
            }
        return pricing
    except Exception as e:
        logger.warning(f"Failed to load model pricing: {e}")
        return {}

class X402Middleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next: RequestResponseEndpoint) -> Response:
        # Skip if x402 is disabled
        if not settings.X402_ENABLED:
            return await call_next(request)

        method = request.method
        url = request.url
        path = url.path
        route_key = f"{method} {path}"

        # Determine if this route requires payment and compute the price
        price_str = None
        if route_key in ROUTE_PRICING:
            static_price = ROUTE_PRICING[route_key]
            if static_price != "$0.00":
                # Special handling for dynamic pricing
                if method == "POST" and path in ["/x402/v1/chat/completions", "/x402/v1/responses"]:
                    try:
                        # Read body to extract model for dynamic pricing
                        body = await request.body()
                        data = json.loads(body)
                        model_id = data.get("model")
                        if model_id:
                            model_pricing = get_model_pricing()
                            if model_id in model_pricing:
                                info = model_pricing[model_id]
                                # Base cost for 1000 input + 1000 output tokens (2000 tokens total)
                                base_cost = info['input_cost_per_1k_tokens'] + info['output_cost_per_1k_tokens']
                                # Apply 27.5% markup (midpoint of 25-30%)
                                marked_up_cost = base_cost * 1.275
                                # Format as dollar string with 6 decimal places
                                price_str = f"${max(marked_up_cost, 0.000001):.6f}"
                            else:
                                # Model not found, fall back to static price
                                price_str = static_price
                        else:
                            # No model specified, fall back to static price
                            price_str = static_price
                        # Replace the request body so downstream can read it again
                        async def receive():
                            return {"type": "http.request", "body": body}
                        request._receive = receive
                    except (json.JSONDecodeError, KeyError, AttributeError, TypeError) as e:
                        logger.warning(f"Failed to parse request body for dynamic pricing: {e}")
                        price_str = static_price
                elif method == "POST" and path == "/x402/v1/images/generations":
                    try:
                        # Read body to extract 'n' for dynamic pricing
                        body = await request.body()
                        data = json.loads(body)
                        n = data.get("n", 1)
                        if n == 1:
                            price_per_image = 0.04  # $0.04 for single image
                        else:
                            price_per_image = 0.035  # $0.035 per image for batch
                        total_price = n * price_per_image
                        price_str = f"${total_price:.6f}"
                        # Replace the request body so downstream can read it again
                        async def receive():
                            return {"type": "http.request", "body": body}
                        request._receive = receive
                    except (json.JSONDecodeError, KeyError, AttributeError, TypeError) as e:
                        logger.warning(f"Failed to parse request body for image generation pricing: {e}")
                        price_str = static_price
                else:
                    price_str = static_price
            # else: free route, price_str remains None
        # else: route not in ROUTE_PRICING, assume free (no payment required)

        # If no payment required, proceed to next middleware/endpoint
        if price_str is None or price_str == "$0.00":
            return await call_next(request)

        # Convert price string to USDC atomic units (string representing integer)
        required = usd_to_usdc_atomic(price_str)

        # Check for payment headers
        payment_signature = request.headers.get("payment-signature")
        x_payment = request.headers.get("x-payment")
        x_correlation_id = request.headers.get("x-correlation-id")

        if not (payment_signature and x_payment):
            # Return 402 Payment Required with challenge
            challenge = {
                "x402_version": 1,
                "asset": "usdc",
                "asset_id": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",  # USDC on Base
                "network": "base",
                "max_amount_required": required,
                "resource": settings.X402_RESOURCE_BASE.rstrip("/") + path,
                "description": ROUTE_DESCRIPTIONS.get(route_key, "Access to this resource"),
                "mime_type": "application/json",
            }
            # Add expires_at and other fields as needed per x402 spec
            return JSONResponse(
                status_code=status.HTTP_402_PAYMENT_REQUIRED,
                content={
                    "error": "Payment required",
                    "accepts": [challenge]
                },
                headers={
                    "Accept": "application/json",
                    "WWW-Authenticate": 'Bearer realm="x402"',
                }
            )

        # Payment headers present, verify and settle via CDP facilitator
        facilitator_url = settings.X402_FACILITATOR_URL
        if not facilitator_url:
            logger.error("X402_FACILITATOR_URL not configured")
            return JSONResponse(
                status_code=status.HTTP_502_BAD_GATEWAY,
                content={"error": "Payment processor not configured"}
            )

        validation_body = {
            "payload": {
                "resource": settings.X402_RESOURCE_BASE.rstrip("/") + path,
                "method": method,
                "headers": {
                    "payment-signature": payment_signature,
                    "x-payment": x_payment,
                    **( {"x-correlation-id": x_correlation_id} if x_correlation_id else {} ),
                },
                "body": await request.body() if method in ["POST", "PUT", "PATCH", "DELETE"] else None,
            }
        }

        async with httpx.AsyncClient(timeout=30.0) as client:
            try:
                # Validate payment with facilitator
                validate_res = await client.post(
                    f"{facilitator_url}/validate",
                    json=validation_body,
                    headers={"Content-Type": "application/json"}
                )
                if validate_res.status_code != 200:
                    logger.warning(f"x402 validation failed: {validate_res.text}")
                    return JSONResponse(
                        status_code=status.HTTP_402_PAYMENT_REQUIRED,
                        content={"error": "Payment validation failed", "details": validate_res.text}
                    )
                validate_data = validate_res.json()
                if not validate_data.get("success", False):
                    logger.warning(f"x402 validation unsuccessful: {validate_data}")
                    return JSONResponse(
                        status_code=status.HTTP_402_PAYMENT_REQUIRED,
                        content={"error": "Payment validation unsuccessful", "details": validate_data}
                    )

                # Settle payment with facilitator
                settle_res = await client.post(
                    f"{facilitator_url}/settle",
                    json=validation_body,
                    headers={"Content-Type": "application/json"}
                )
                if settle_res.status_code != 200:
                    logger.warning(f"x402 settlement failed: {settle_res.text}")
                    return JSONResponse(
                        status_code=status.HTTP_402_PAYMENT_REQUIRED,
                        content={"error": "Payment settlement failed", "details": settle_res.text}
                    )
                settle_data = settle_res.json()
                if not settle_data.get("success", False):
                    logger.warning(f"x402 settlement unsuccessful: {settle_data}")
                    return JSONResponse(
                        status_code=status.HTTP_402_PAYMENT_REQUIRED,
                        content={"error": "Payment settlement unsuccessful", "details": settle_data}
                    )
            except Exception as e:
                logger.error(f"x402 facilitator communication error: {e}")
                return JSONResponse(
                    status_code=status.HTTP_502_BAD_GATEWAY,
                    content={"error": "Payment processor communication error"}
                )

        # Payment verified and settled, proceed to request
        response = await call_next(request)
        # Add payment response header
        success_payload = json.dumps({"success": True, "details": settle_data})
        response.headers["X-PAYMENT-RESPONSE"] = base64.b64encode(success_payload.encode()).decode()
        return response